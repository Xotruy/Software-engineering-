ACTIVE_ITEM_TYPE = "A"
NO_DISCOUNT_RATE = 0.0

DISCOUNT_RATES: dict[int, float] = {
    1: 0.10,  # Стандартная скидка 10%
    2: 0.20,  # Повышенная скидка 20%
}


def calculate_item_total(
    unit_price: float,
    quantity: int,
    discount_tier: int = 0,
) -> float:
    """Вычисляет итоговую стоимость позиции заказа с учетом скидки.

    Args:
        unit_price: Цена за единицу товара.
        quantity: Количество единиц товара.
        discount_tier: Код уровня скидки (1 — 10%, 2 — 20%).

    Returns:
        Итоговая неотрицательная стоимость позиции.
    """
    base_total = unit_price * quantity
    discount_rate = DISCOUNT_RATES.get(discount_tier, NO_DISCOUNT_RATE)
    discounted_total = base_total * (1.0 - discount_rate)
    return max(0.0, discounted_total)


def calculate_active_items_totals(items: list[dict[str, Any]]) -> list[float]:
    """Обрабатывает список позиций и возвращает список стоимостей.

    Для активных позиций (тип 'A') рассчитывается стоимость со скидкой,
    для остальных позиций возвращается 0.0.

    Args:
        items: Список словарей с данными о позициях заказа.

    Returns:
        Список рассчитанных стоимостей для каждой позиции.
    """
    return [
        calculate_item_total(
            unit_price=item["price"],
            quantity=item["quantity"],
            discount_tier=item.get("discount_tier", 0),
        )
        if item.get("type") == ACTIVE_ITEM_TYPE
        else 0.0
        for item in items
    ]


