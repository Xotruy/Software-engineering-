from collections import Counter
from typing import Iterable, TypeVar

T = TypeVar("T")


def double_values(numbers: Iterable[float]) -> list[float]:
    """Возвращает новый список, где каждый элемент умножен на 2."""
    # Почему так: list comprehension читается в одну строку как естественное
    # предложение, работает быстрее цикла с .append() и не требует индексов i.
    return [number * 2 for number in numbers]


def count_item_frequencies(items: Iterable[T]) -> dict[T, int]:
    """Подсчитывает количество вхождений каждого элемента в последовательности."""
    # Почему так: Counter из стандартной библиотеки collections оптимизирован
    # на уровне C, убирает 6 строк ручного if/else и сразу говорит читателю,
    # что происходит подсчет частот.
    return dict(Counter(items))


def get_sorted_items(items: Iterable[T]) -> list[T]:
    """Возвращает новый отсортированный список, не изменяя исходную коллекцию."""
    # Почему так: встроенная функция sorted() создает и возвращает новый список,
    # тогда как метод .sort() мутирует входной аргумент (побочный эффект)
    # и возвращает None, что приводило к багу.
    return sorted(items)


